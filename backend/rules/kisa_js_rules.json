[
  {
    "id": "JS-KISA-001",
    "title": "SQL 삽입",
    "category": "입력데이터 검증 및 표현",
    "severity": "HIGH",
    "cwe": "CWE-89",
    "detectionType": "AST + Regex",
    "description": "검증되지 않은 외부 입력값이 동적 SQL 문자열에 결합되어 데이터베이스 질의로 실행되는 패턴을 탐지한다.",
    "detectPatterns": [
      "(?is)\\b(?:connection|db|client|pool)\\.(?:query|execute|raw)\\s*\\([^)]*(?:\\+|\\$\\{)"
    ],
    "safePatterns": [
      "(?is)\\b(?:query|execute)\\s*\\(\\s*[\"'][^\"']*\\?[^\"']*[\"']\\s*,\\s*\\[",
      "(?is)\\b(?:where|data)\\s*:\\s*\\{",
      "(?is)\\b(?:prisma|sequelize)\\."
    ],
    "astSignals": ["call:query", "call:execute", "call:raw"],
    "recommendation": "SQL 문자열 결합을 중단하고 파라미터 바인딩, Prepared Statement, ORM 조건 객체를 사용한다.",
    "kisaReference": "JavaScript 시큐어코딩 가이드 2023",
    "kisaItem": "제1절 입력데이터 검증 및 표현 > SQL 삽입"
  },
  {
